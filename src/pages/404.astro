---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page Not Found | exoskeletoninjuries.com" description="The requested page could not be found." noindex={true}>
  <Header />
  <main id="content" class="flex flex-1 items-center justify-center px-5 py-20">
    <div class="mx-auto max-w-md text-center">
      <p class="font-display text-6xl text-copper">404</p>
      <h1 class="mt-4 text-2xl font-semibold">Page not found</h1>
      <p class="mt-3 text-quiet">That address is not part of this sale. The domain itself is still available.</p>
      <a href="/" class="btn-copper mt-8">Return to the name</a>
    </div>
  </main>
  <Footer />
</Layout>
