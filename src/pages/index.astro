---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const advancements = (await getCollection('advancements')).sort(
  (a, b) => a.data.order - b.data.order
);

const medical = await Promise.all(
  advancements
    .filter((a) => a.data.category === 'Medical' || a.data.category === 'Research')
    .map(async (item) => {
      const { Content } = await item.render();
      return { ...item, Content };
    })
);

const consumerIndustrial = await Promise.all(
  advancements
    .filter((a) => a.data.category === 'Consumer' || a.data.category === 'Industrial')
    .map(async (item) => {
      const { Content } = await item.render();
      return { ...item, Content };
    })
);
---

<Layout>
  <Header />

  <main class="flex-1">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-900/40 via-slate-925 to-slate-925"></div>
      <div class="absolute inset-0 opacity-40" style="background-image: url('data:image/svg+xml;base64,');"></div>

      <div class="container-narrow relative section-pad pt-16 sm:pt-28">
        <div class="mx-auto w-full max-w-3xl text-center">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-sm font-medium text-brand-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-400"></span>
            </span>
            2026 Industry Outlook
          </div>

          <h1 class="mb-6 text-[2rem] font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
            Wearable Exoskeletons
            <span class="block gradient-text mt-2">Enter the Mainstream</span>
          </h1>

          <p class="mx-auto mb-10 max-w-2xl text-base text-slate-400 leading-relaxed sm:text-lg">
            From clinical prototypes to consumer devices — AI, lightweight materials, and soft robotics are accelerating adoption across healthcare, industrial safety, defense, and personal mobility.
          </p>

          <div class="flex w-full flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-4">
            <a href="#breakthroughs" class="btn-primary w-full sm:w-auto">
              Explore Breakthroughs
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a
              href="mailto:sales@desertrich.com?subject=Domain%20Inquiry%3A%20exoskeletoninjuries.com"
              class="btn-ghost w-full sm:w-auto"
            >
              Domain Acquisition
            </a>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="mt-12 grid grid-cols-2 gap-3 sm:mt-16 sm:grid-cols-4 sm:gap-6">
          <div class="card p-4 text-center sm:p-5">
            <div class="text-xl font-bold text-brand-300 sm:text-3xl">24.3%</div>
            <div class="mt-1 text-sm text-slate-500">Metabolic energy savings</div>
          </div>
          <div class="card p-4 text-center sm:p-5">
            <div class="text-xl font-bold text-brand-300 sm:text-3xl">4.2 lb</div>
            <div class="mt-1 text-sm text-slate-500">Soft exosuit weight</div>
          </div>
          <div class="card p-4 text-center sm:p-5">
            <div class="text-xl font-bold text-brand-300 sm:text-3xl">ms</div>
            <div class="mt-1 text-sm text-slate-500">Intent detection latency</div>
          </div>
          <div class="card p-4 text-center sm:p-5">
            <div class="text-xl font-bold text-brand-300 sm:text-3xl">2026</div>
            <div class="mt-1 text-sm text-slate-500">Consumer expansion year</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Medical & Research Breakthroughs -->
    <section id="breakthroughs" class="section-pad border-t border-slate-800/60">
      <div class="container-narrow">
        <div class="mb-12 max-w-2xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-brand-400">Medical & Rehabilitation</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">Clinical Breakthroughs</h2>
          <p class="mt-4 text-slate-400 leading-relaxed">
            Devices once confined to labs are receiving regulatory clearances and demonstrating measurable outcomes in pain reduction, energy efficiency, and mobility restoration.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {medical.map((item) => (
            <article class="card group p-6">
              <div class="mb-4 flex items-start justify-between gap-2">
                <span class="inline-flex rounded-full bg-brand-500/10 px-2.5 py-0.5 text-xs font-medium text-brand-300">
                  {item.data.category}
                </span>
                {item.data.highlight && (
                  <span class="text-xs text-slate-500 text-right">{item.data.highlight}</span>
                )}
              </div>
              <h3 class="mb-2 text-lg font-semibold text-white group-hover:text-brand-300 transition">
                {item.data.title}
              </h3>
              {item.data.organization && (
                <p class="mb-3 text-sm font-medium text-slate-500">{item.data.organization}</p>
              )}
              <div class="text-sm text-slate-400 leading-relaxed">
                <item.Content />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Consumer & Industrial -->
    <section id="sectors" class="section-pad border-t border-slate-800/60 bg-slate-900/40">
      <div class="container-narrow">
        <div class="mb-12 max-w-2xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-brand-400">Market Expansion</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">Consumer & Industrial Adoption</h2>
          <p class="mt-4 text-slate-400 leading-relaxed">
            Beyond the clinic, exoskeletons are entering factories, warehouses, hiking trails, and everyday life — reducing injury rates and extending human capability.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {consumerIndustrial.map((item) => (
            <article class="card group p-6">
              <div class="mb-4 flex items-start justify-between gap-2">
                <span class="inline-flex rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-xs font-medium text-cyan-300">
                  {item.data.category}
                </span>
                {item.data.highlight && (
                  <span class="text-xs text-slate-500 text-right">{item.data.highlight}</span>
                )}
              </div>
              <h3 class="mb-2 text-lg font-semibold text-white group-hover:text-brand-300 transition">
                {item.data.title}
              </h3>
              {item.data.organization && (
                <p class="mb-3 text-sm font-medium text-slate-500">{item.data.organization}</p>
              )}
              <div class="text-sm text-slate-400 leading-relaxed">
                <item.Content />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Context / Disclaimer strip -->
    <section class="border-t border-slate-800/60 py-10">
      <div class="container-narrow">
        <div class="rounded-2xl border border-slate-700/50 bg-slate-850/50 p-6 text-center">
          <p class="text-sm text-slate-500 leading-relaxed max-w-3xl mx-auto">
            This website is for demonstration and informational purposes only. It does not constitute an offer of services, a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific technologies are based on publicly available information as of August 2026 and are subject to change.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
