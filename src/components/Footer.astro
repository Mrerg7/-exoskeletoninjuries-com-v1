---
import { AGENT_MAIL, DOMAIN, EMAIL, SELLER } from "../lib/sale";
const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
  <div class="container-narrow grid gap-8 py-12 sm:grid-cols-2">
    <div>
      <p class="font-display text-2xl">{DOMAIN}</p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-quiet">
        Demonstration and acquisition page from {SELLER}. Industry notes summarize publicly reported work as of
        August 2026 and are not a promise of rankings, traffic, or clinical outcomes. Asking price updated October
        2026.
      </p>
    </div>
    <div class="sm:text-right">
      <p class="text-sm text-quiet">Seller</p>
      <a href={`mailto:${EMAIL}`} class="mt-1 inline-flex min-h-12 items-center font-medium">{EMAIL}</a>
      <div class="mt-2 flex flex-wrap gap-x-4 sm:justify-end">
        <a href="/" class="inline-flex min-h-12 items-center text-sm">The name</a>
        <a href="/buyers/" class="inline-flex min-h-12 items-center text-sm">Buyers</a>
        <a href="/transfer/" class="inline-flex min-h-12 items-center text-sm">Transfer</a>
        <a href={AGENT_MAIL} class="inline-flex min-h-12 items-center text-sm">Contact</a>
      </div>
    </div>
  </div>
  <div class="border-t border-rule">
    <p class="container-narrow py-4 text-xs text-quiet">
      © {year} {SELLER}. Domain only. Not legal, medical, or investment advice.
    </p>
  </div>
</footer>

<dialog id="exit-dialog" aria-labelledby="exit-title">
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="kicker">Before you leave</p>
        <h2 id="exit-title" class="mt-2 font-display text-3xl tracking-tight">One name. Send a number.</h2>
      </div>
      <button
        type="button"
        data-exit-close
        class="inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg border border-rule"
        aria-label="Dismiss">Close</button
      >
    </div>
    <p class="mt-3 text-sm leading-relaxed text-quiet">
      Asking price is $100,000. If you have a different number, send it. No discount timer, no list resale.
    </p>
    <form id="exit-form" class="mt-5 grid gap-3">
      <label class="text-sm">
        Email
        <input type="email" name="email" required class="field" />
      </label>
      <label class="text-sm">
        Number in mind <span class="text-quiet">(optional)</span>
        <input name="amount" inputmode="decimal" class="field" />
      </label>
      <p id="exit-status" class="text-sm text-pine" hidden></p>
      <button type="submit" class="btn-copper">Email the seller</button>
    </form>
  </div>
</dialog>
