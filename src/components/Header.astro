---
import { BUY_MAIL, PRICE_LABEL } from "../lib/sale";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "The name" },
  { href: "/buyers/", label: "Buyers" },
  { href: "/transfer/", label: "Transfer" },
  { href: "/#offer", label: "Inquire" },
];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-md">
  <div class="container-narrow flex items-center gap-3 py-2">
    <a href="/" class="flex min-h-12 min-w-0 items-center gap-3">
      <svg viewBox="0 0 32 32" class="h-9 w-9 shrink-0" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" rx="7" class="fill-copper"></rect>
        <path
          d="M16 7.5v17M11.5 11.5h9M10.5 16h11M11.5 20.5h9"
          class="stroke-copper-ink"
          stroke-width="1.7"
          fill="none"
          stroke-linecap="round"></path>
      </svg>
      <span class="min-w-0">
        <span class="block truncate font-display text-lg leading-none tracking-tight">Exoskeleton Injuries</span>
        <span class="mt-1 block text-xs uppercase tracking-widest text-quiet">{PRICE_LABEL} · for sale</span>
      </span>
    </a>
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "inline-flex min-h-12 items-center rounded-lg px-3 text-sm font-medium",
              path === link.href ? "text-ink" : "text-quiet hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-2 lg:ml-3">
      <button
        type="button"
        data-theme-toggle
        aria-label="Switch color theme"
        class="inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg border border-rule bg-card text-ink"
      >
        <svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
        </svg>
        <svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <span class="sr-only">Theme</span>
      </button>
      <a href={BUY_MAIL} class="btn-copper px-4 text-sm sm:px-5">Buy now</a>
      <details class="relative lg:hidden">
        <summary
          class="inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg border border-rule bg-card"
          aria-label="Open menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="absolute right-0 z-50 mt-2 w-56 rounded-lg border border-rule bg-card p-2" aria-label="Mobile">
          {
            links.map((link) => (
              <a href={link.href} class="flex min-h-12 items-center rounded-lg px-3 text-base font-medium">
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
